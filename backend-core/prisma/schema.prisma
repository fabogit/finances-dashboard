// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model RawTransaction {
  id String @id @default(uuid())

  // Import Metadata
  importBatchId String // UUID
  originalLine  Int // row

  // Data
  date             String
  operation        String
  details          String
  account          String
  accountingStatus String
  category         String?
  currency         String
  amount           String

  createdAt DateTime @default(now())
}
