// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model RawTransaction {
  id String @id @default(uuid())

  // Import Metadata
  importBatchId String // UUID
  originalLine  Int // row

  // Data
  date             String
  operation        String
  details          String
  account          String
  accountingStatus String
  category         String?
  currency         String
  amount           String

  createdAt DateTime @default(now())
}

model EnrichedTransaction {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  importBatchId String
  originalLine  Int

  date      DateTime
  amount    Float
  operation String
  details   String
  account   String
  category  String

  @@index([importBatchId])
  @@index([date])
  @@index([category])
}
