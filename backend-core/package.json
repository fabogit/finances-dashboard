    "@nestjs/serve-static": "^12.1.1",
    "@nestjs/swagger": "^12.1.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "axios": "^1.21.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.10",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "xlsx": "^0.18.5"
  },
  "description": "",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.4.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "dotenv-cli": "^11.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^16.5.0",
    "prettier": "^3.8.3",
    "prisma": "^7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.22.2",
    "pnpm": ">=12.18.0"
  },
  "license": "UNLICENSED",
  "name": "backend-core",
  "packageManager": "pnpm@12.18.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "db:test:down": "docker-compose -f ../docker-compose.test.yml down",
    "db:test:migrate": "dotenv-cli -e .env.test -- prisma migrate deploy",
    "db:test:push": "dotenv-cli -e .env.test -- prisma db push",
    "db:test:up": "docker-compose -f ../docker-compose.test.yml up -d --wait",
    "docker:down": "docker-compose --env-file ../.env.compose down",
    "docker:up": "docker-compose --env-file ../.env.compose up --build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test,prisma}/**/*.ts\" --fix",
    "prisma:deploy": "dotenv-cli -e .env.local -- prisma migrate deploy",
    "prisma:generate": "dotenv-cli -e .env.local -- prisma generate",
    "prisma:migrate": "dotenv-cli -e .env.local -- prisma migrate dev",
    "prisma:reset": "dotenv-cli -e .env.local -- prisma migrate reset",
    "prisma:studio": "dotenv-cli -e .env.local -- prisma studio",
    "prisma:push": "dotenv-cli -e .env.local -- prisma db push",
    "prisma:seed": "dotenv-cli -e .env.local -- prisma db seed",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:e2e:docker": "pnpm run db:test:up && pnpm run db:test:push && pnpm run test:e2e && pnpm run db:test:down",
    "test:watch": "vitest"
  },
  "type": "module",
  "version": "1.0.0"
}
