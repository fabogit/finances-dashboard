# --- POSTGRES CONFIGURATION ---
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=finance_db
POSTGRES_PORT=5432

# --- SERVER CONFIGURATION ---
SERVER_PORT=3000
SCIENCE_PORT=8000

# --- INTERNAL SERVICE URLS ---
# "fn-postgres" & "backend-science" are the containers names in the docker-compose.yaml
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@fn-postgres:5432/${POSTGRES_DB}?schema=public
SCIENCE_SERVICE_URL=http://backend-science:8000

# --- SCIENCE CLIENT (backend-core -> backend-science) ---
# Per-attempt timeout (ms) and retries for transient failures (defaults: 10000, 2)
SCIENCE_TIMEOUT_MS=10000
SCIENCE_RETRY_COUNT=2
